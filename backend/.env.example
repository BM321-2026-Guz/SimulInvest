# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env commit edilmez.
DATABASE_URL=sqlite:///./simulinvest.db
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=degistir-beni
JWT_EXPIRES_SECONDS=3600
# live: dış API'lerden çek (hata olursa yedek fiyat), mock: sadece yedek fiyatlar
PRICE_SOURCE=live
PRICE_CACHE_SECONDS=60
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
